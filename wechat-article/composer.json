{
    "name": "quansitech/cmf-module-wechat-article",
    "description": "QS CMF 公众号文章模块：RichEditor 自定义块嵌入公众号原文（保真只读 iframe），保存时抓取快照、图片落地到媒体库",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "quansitech/cmf-core": "^1.0",
        "quansitech/cmf-module-media": "^1.3||^1.4",
        "symfony/html-sanitizer": "^7.0||^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Quansitech\\Cmf\\WechatArticle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quansitech\\Cmf\\WechatArticle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Quansitech\\Cmf\\WechatArticle\\WechatArticleServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
